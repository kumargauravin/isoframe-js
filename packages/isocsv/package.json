{
  "name": "@nice-tools/isocsv",
  "version": "0.1.0",
  "description": "Isomorphic zero-dependency CSV/TSV parser that returns IsoFrame-compatible data",
  "keywords": ["csv", "tsv", "parser", "isomorphic", "dataframe"],
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && tsc -p tsconfig.cjs.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^2.0.0"
  }
}
